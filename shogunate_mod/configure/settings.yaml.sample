language: ja
shell: bash
multiplexer:
  default: tmux
topology:
  active_ashigaru:
  - ashigaru1
  - ashigaru2
  - ashigaru3
  - ashigaru4
cli:
  default: codex
  codex:
    shared_auth: true
    shared_auth_file: .shogunate/codex/shared/auth.json
  agents:
    shogun:
      type: codex
      fallback: null
    gunkan:
      type: codex
      fallback: null
    gunshi:
      type: codex
      fallback: null
    karo:
      type: codex
      fallback: null
    ashigaru1:
      type: opencode
      fallback: null
    ashigaru2:
      type: opencode
      fallback: null
    ashigaru3:
      type: codex
      fallback: null
    ashigaru4:
      type: gemini
      fallback: null
update:
  startup_check: true
  auto_apply_release: false
preserve_paths:
- .codex/
- .shogunate/
- .claude/
- config/moa.yaml
- projects/
- context/local/
- instructions/local/
- skills/local/
- memory/global_context.md
transport:
  mode: yaml          # yaml | agmsg | both (yaml = current behavior)
  agmsg:
    team: shogunate
    skill_dir: ""      # empty = ~/.agents/skills/agmsg
    bridge_agents: []   # agents that also get agmsg wake-ups while mode=yaml
council:
  default:
    members:
      fable:
        type: claude
        model: claude-fable-5
      opus:
        type: claude
        model: claude-opus-5
      sol:
        type: codex
        model: gpt-5.6-sol
    representative: fable
